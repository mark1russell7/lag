{
  "name": "@mark1russell7/lag",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./event-line.js": {
      "types": "./dist/event-line.d.ts",
      "import": "./dist/event-line.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json tsconfig.worker.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "4.1.2",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.7.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "page-lifecycle-tracker": "^0.1.0"
  }
}
