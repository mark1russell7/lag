{
  "name": "@lag/integration-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "cd node_modules/@mark1russell7/grafana-infra && docker compose up -d",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
