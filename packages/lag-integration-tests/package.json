  },
  "devDependencies": {
    "@mark1russell7/grafana-infra": "github:mark1russell7/grafana-infra",
    "@vitest/browser": "^4.1.2",
    "@vitest/browser-playwright": "^4.1.2",
    "playwright": "^1.56.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  }
}
