{
  "name": "@lag/integration-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --project browser --project cdp --project bfcache --project coi",
    "test:browser": "vitest run --project browser --project cdp --project bfcache --project coi",
    "test:cdp": "vitest run --project cdp",
    "test:bfcache": "vitest run --project bfcache",
    "test:coi": "vitest run --project coi",
    "test:overhead": "vitest run --project overhead",
    "test:soak": "vitest run --project soak",
    "test:chromium": "vitest run --project \"browser (chromium)\"",
    "test:safari": "LAG_SAFARI=1 vitest run --project \"browser (safari)\"",
    "test:ios": "LAG_IOS=1 vitest run --project \"browser (ios)\"",
    "test:e2e": "pnpm run infra:up && vitest run --project e2e",
    "test:watch": "vitest --project \"browser (chromium)\"",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "infra:up": "cd node_modules/@mark1russell7/grafana-infra && docker compose up -d",
    "infra:down": "cd node_modules/@mark1russell7/grafana-infra && docker compose down"
  },
  "dependencies": {
    "@lag/load": "workspace:*",
    "@mark1russell7/lag": "workspace:*",
    "@mark1russell7/otel-ts": "github:mark1russell7/otel-ts"
  },
  "devDependencies": {
    "@mark1russell7/grafana-infra": "github:mark1russell7/grafana-infra",
    "@types/node": "^25.3.0",
    "@vitest/browser": "^4.1.2",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/browser-webdriverio": "^4.1.2",
    "playwright": "^1.56.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.2",
    "web-vitals": "^6.2.3",
    "webdriverio": "^9.32.0"
  }
}
